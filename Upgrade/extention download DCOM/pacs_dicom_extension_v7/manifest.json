{
  "manifest_version": 3,
  "name": "DICOM Download & View",
  "version": "7.0.2",
  "description": "Generic PACS DICOM downloader: protocol/content discovery, DICOMweb/WADO, direct/manifest DICOM, ZFP WebSocket fallback, per-tab download.",
  "minimum_chrome_version": "125",
  "permissions": [
    "activeTab",
    "downloads",
    "downloads.ui",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "DICOM Download & View",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
